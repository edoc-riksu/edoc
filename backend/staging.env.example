# Copy to .env.staging on the server. Never commit the real file (.env.* is
# git-ignored). No secrets are needed by this service today.

# Public hostname that points at this server. Caddy gets the HTTPS
# certificate for it automatically.
EDOC_DOMAIN=api-staging.example.com

# Sites allowed to call this service from a browser. Comma-separated, no
# trailing slashes. Use the real production and staging web app URLs.
CORS_ALLOWED_ORIGINS=https://edoc-drab.vercel.app

# Optional: Vercel preview URLs change per deploy, so match them by pattern.
# Leave empty to disallow previews.
CORS_ALLOWED_ORIGIN_REGEX='https://edoc-.*-edoc-riksu\.vercel\.app'

# How many code runs may be in Piston at once. A small VM (2 vCPU) is fine with
# 8; extra runs wait up to 20 seconds, then fail with a retryable error.
MAX_CONCURRENT_EXECUTIONS=8

LOG_LEVEL=INFO
