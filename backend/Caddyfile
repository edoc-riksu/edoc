# Caddy terminates HTTPS (it gets and renews the certificate by itself) and
# forwards everything to the backend. EDOC_DOMAIN comes from .env.staging,
# e.g. api-staging.example.com, or <server-ip-with-dashes>.sslip.io if you
# have no domain yet. The name must point at this server's public IP.
{$EDOC_DOMAIN} {
	reverse_proxy backend:8000
}
