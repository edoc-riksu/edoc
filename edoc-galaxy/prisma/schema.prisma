generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  // Mirrors the client-side "Biometric Link" callsign (PilotContext.js) so
  // real accounts can take over that identity once sign-in is wired up.
  pilotCallsign String     @unique
  avatar        String?    @db.Text
  // Hangar loadout — cosmetic only, never affects judging/scoring.
  // "vega" | "taro" for explorer, "base" | "starfarer" for suit.
  explorer      String     @default("vega")
  suit          String     @default("base")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  progress      Progress[]
  attempts      Attempt[]

  @@map("users")
}

// One row per sector a pilot has made progress in. `sectorId` is the
// sector's display name as used throughout the client (see
// PLANETARY_SYSTEM in src/lib/planetarySystem.js, e.g. "Python Engine
// Core") — kept as a plain string here rather than a foreign key so the
// client's existing `pilotProgress` shape (sectorId -> level) maps
// directly onto this table without an extra sectors table this week.
model Progress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sectorId  String
  level     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, sectorId])
  @@map("progress")
}

// A planet/language's set of encounters (e.g. "python-basics" on the
// "python" planet). Mirrors contracts/example-encounter.json's "module"
// field - `slug` is what encounters reference, `planetId` is the galaxy
// map's planet id (see edoc-galaxy/src/galaxy/layout.js PLANETS).
model Module {
  id         String     @id @default(cuid())
  slug       String     @unique
  planetId   String
  title      String
  order      Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  encounters Encounter[]

  @@map("modules")
}

// A lightweight index of encounters for navigation (module lists, galaxy
// map, locking logic) - never the problem text, starter code or tests.
// Those stay owned by Backend 1's execution service and are fetched live
// from GET /api/v1/encounters/{id}; duplicating them here would risk
// leaking hidden tests out of sync with that service.
model Encounter {
  id        String   @id
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  difficulty String
  concepts  String[]
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
  @@map("encounters")
}

// One row per submission judged by Backend 1's execution service
// (POST /api/v1/submissions). `id` is that submission's own submission_id
// (a uuid), so saving an attempt is just "store the result you were
// already given" - no id translation needed. `encounterId` is kept as a
// plain string (like Progress.sectorId) rather than a hard foreign key,
// so an attempt is never lost if its Encounter index row hasn't been
// seeded yet. Only a submission's verdict/score count toward progress or
// damage, never a run - see contracts/README.md.
model Attempt {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  encounterId String
  verdict    String
  scoreEarned Int
  scoreTotal  Int
  runtimeMs   Int
  hintsUsed   Int      @default(0) @db.SmallInt
  createdAt   DateTime @default(now())

  @@index([userId, encounterId])
  @@map("attempts")
}
