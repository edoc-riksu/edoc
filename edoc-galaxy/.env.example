# Postgres connection string (accounts and progress are stored here via
# Prisma - see prisma/schema.prisma). Copy to .env.local and point it at
# your own dev database; never commit a real value.
DATABASE_URL=

# Secret used to sign the session cookie. Set a real random value in
# production (Vercel project settings > Environment Variables).
AUTH_SECRET=

# development | staging | production - used by src/lib/db.js and
# src/lib/logger.js to decide connection caching and log format.
APP_ENV=development

# Backend 1's judging service (see contracts/README.md). Run the mock
# server locally (`uvicorn app.mock_main:app --port 8001` from backend/)
# and leave this unset to use it, or point at a real deployment once one
# exists — there is no staging URL yet.
NEXT_PUBLIC_EXECUTION_API_URL=http://localhost:8001
