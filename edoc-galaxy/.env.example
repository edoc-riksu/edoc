# Optional: connect a Redis/KV storage resource (Vercel Storage > Upstash for
# Redis, or any Upstash Redis database) to make sign-up/sign-in persist in
# production. Without these, auth falls back to a /tmp file that Vercel does
# not share or guarantee to persist across serverless invocations, so a
# sign-in shortly after sign-up can wrongly fail with "password doesn't match".
#
# Vercel's own Storage integration injects KV_REST_API_URL / KV_REST_API_TOKEN
# automatically once connected to this project — you don't need to set these
# by hand in that case. Set them here only for local testing against a real
# Redis database instead of the file fallback.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Secret used to sign the session cookie. Set a real random value in
# production (Vercel project settings > Environment Variables).
AUTH_SECRET=
